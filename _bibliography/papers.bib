@article{LEE2024101962,
title = {PyCAN: Open-source Python software of N-dimensional Content-Addressable Network},
journal = {SoftwareX},
volume = {28},
pages = {101962},
year = {2024},
issn = {2352-7110},
doi = {https://doi.org/10.1016/j.softx.2024.101962},
url = {https://www.sciencedirect.com/science/article/pii/S2352711024003327},
author = {Yuchan Lee and Sookwang Lee and Jaehwan Lee},
keywords = {Peer-to-peer, Distributed hash table, Content-addressable network, Python, Multidimensional euclidean space},
abstract = {We propose PyCAN, the first open-source Python implementation of N-dimensional Content-Addressable Network (CAN) with full feature sets to maintain peer-to-peer structure. Existing CAN implementations supports limited functions of Distributed Hash Table (DHT), so they cannot be used in practice. However, PyCAN offers full set of features such as N-dimension coordinates, node removal followed by node taking over, and a verification method to keep peer-to-peer structure. By extensive experiments, we confirm that PyCAN supports scalable overlay structures, so it is practically usable in peer-to-peer systems.},
abbr = {SoftwareX},
code = {https://github.com/2uchan/PyCAN}
}

@inproceedings{10.1145/3754598.3754654,
author = {Jang, Sooho and Lim, Ahyeon and Lee, Yuchan and Lee, Sookwang and Lee, Jaehwan},
title = {P3P-Fed: Peer-to-Peer Personalized Federated Learning with DHT-based Local Clustering},
year = {2025},
isbn = {9798400720741},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3754598.3754654},
doi = {10.1145/3754598.3754654},
abstract = {Federated Learning (FL) enables the training of a single global model in a distributed manner while preserving the privacy of local data. In real-world FL environments, however, characterized by high heterogeneity in client data distributions (non-IID), the global model often suffers from performance degradation. To address this challenge, Personalized Federated Learning (PFL) has been proposed to provide personalized models either by clustering clients or by decoupling the model into shared and personalized components. Although partially effective, PFL using a client-server architecture often fails to capture client-specific characteristics and suffers from communication and computation bottlenecks. In this work, we present P3P-Fed, a personalized decentralized federated learning framework that performs clustering at the node level. By grouping nodes that have similar data distributions, each client achieves robust personalization even in highly heterogeneous non-IID environments where clustering at the global level is not feasible. To balance global model generalization and local personalization, P3P-Fed introduces a personalized head training strategy with partial aggregation and a differential learning rate. We evaluated P3P-Fed on a real-world testbed across varying degrees of data heterogeneity. The results show that P3P-Fed outperformed other baseline methods by as much as 8.64\% and achieved the fastest convergence.},
booktitle = {Proceedings of the 54th International Conference on Parallel Processing},
pages = {63–72},
numpages = {10},
keywords = {Peer-to-peer Network, Decentralized Federated Learning (DFL), Personalized Federated Learning (PFL), Data Heterogeneity, Distributed Hash Tables, Clustering},
location = {
},
series = {ICPP '25},
abbr = {ICPP}
}

